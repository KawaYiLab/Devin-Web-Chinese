{
  "manifest_version": 3,
  "name": "Devin 网页端汉化",
  "version": "1.1.1",
  "description": "本地翻译 Devin 主应用界面，支持动态菜单与提示，保护对话正文、代码和输入内容。",
  "content_scripts": [
    {
      "matches": [
        "https://app.devin.ai/*"
      ],
      "js": [
        "dictionary.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": []
}
